PORT=5000
# URI Atlas : remplacez USER, PASSWORD et le cluster. Le nom de base est ecocollecte.
# Si le mot de passe contient des caractères spéciaux (@ : / ? # %), encodez-les (ex. @ devient %40).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ecocollecte?retryWrites=true&w=majority
# Origines autorisées, séparées par des virgules (local + site en ligne plus tard)
CLIENT_URL=http://localhost:5173
# Clé secrète des agents de collecte : choisissez une longue valeur aléatoire
ADMIN_KEY=remplacez-par-une-longue-valeur-aleatoire
